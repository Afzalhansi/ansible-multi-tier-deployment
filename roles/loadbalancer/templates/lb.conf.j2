upstream app_servers {
{% for host in groups['app_server_1'] + groups['app_server_2'] %}
    server {{ hostvars[host]['ansible_host'] }};
{% endfor %}
}

server {
    listen 80;

    location / {
        auth_basic "Restricted Access";
        auth_basic_user_file /etc/nginx/.htpasswd;
        proxy_pass http://app_servers;
    }
}
